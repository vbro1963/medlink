{
  "expo": {
    "name": "MedLink Telehealth",
    "slug": "medlink-telehealth",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "medlink",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.medlink.telehealth",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D9488"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.medlink.telehealth",
      "infoPlist": {
        "NSCameraUsageDescription": "MedLink requires camera access for live doctor-patient video consultations.",
        "NSMicrophoneUsageDescription": "MedLink requires microphone access for live doctor-patient audio consultations."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-webrtc",
        {
          "cameraPermission": "Allow MedLink to access your camera for video appointments.",
          "microphonePermission": "Allow MedLink to access your microphone for video appointments."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://medlink-api-your-project.a.run.app",
      "wsUrl": "wss://medlink-api-your-project.a.run.app/ws"
    }
  }
}
